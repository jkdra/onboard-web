{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "onboard-web",
  "compatibility_date": "2026-07-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "onboard-web"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Runtime env for the Worker. `APP_STORE_ID` is read server-side by
  // /changelog, which is ISR (revalidate 1h) — so it's needed at BUILD time
  // (from .env.local, for the initial static render) *and* here at RUNTIME, or
  // the hourly revalidation re-renders the "coming soon" empty state and caches
  // that for an hour.
  //
  // NEXT_PUBLIC_APP_STORE_URL deliberately does NOT belong here: Next inlines
  // NEXT_PUBLIC_* into the client bundle at build time, so a runtime Worker var
  // would have no effect. It comes from .env.local at build, with a literal
  // fallback in lib/appStore.ts.
  "vars": {
    "APP_STORE_ID": "6782297168"
  },
  "observability": {
    "enabled": true
  }
}
